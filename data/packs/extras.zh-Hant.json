{"id":"extras","name":"名篇补遗","script":"zh-Hant","source":"chinese-poetry@b8594f8 全唐诗/全宋诗（见 scripts/extras.json）","license":"MIT","poems":[{"title":"春江花月夜","author":"張若虛","type":"","lines":["春江潮水連海平","海上明月共潮生","灩灩隨波千萬里","何處春江無月明","江流宛轉遶芳甸","月照花林皆似霰","空裏流霜不覺飛","汀上白沙看不見","江天一色無纖塵","皎皎空中孤月輪","江畔何人初見月","江月何年初照人","人生代代無窮已","江月年年望相似","不知江月待何人","但見長江送流水","白雲一片去悠悠","青楓浦上不勝愁","誰家今夜扁舟子","何處相思明月樓","可憐樓上月裴回","應照離人妝鏡臺","玉戶簾中卷不去","擣衣砧上拂還來","此時相望不相聞","願逐月華流照君","鴻雁長飛光不度","魚龍潛躍水成文","昨夜閑潭夢落花","可憐春半不還家","江水流春去欲盡","江潭落月復西斜","斜月沈沈藏海霧","碣石瀟湘無限路","不知乘月幾人歸","落月搖情滿江樹"],"featured":true},{"title":"詠鵝","author":"駱賓王","type":"","lines":["曲項向天歌","白毛浮綠水","紅掌撥清波"],"featured":true},{"title":"贈汪倫","author":"李白","type":"","lines":["李白乘舟將欲行","忽聞岸上踏歌聲","桃花潭水深千尺","不及汪倫送我情"],"featured":true},{"title":"望天門山","author":"李白","type":"","lines":["天門中斷楚江開","碧水東流至北迴","兩岸青山相對出","孤帆一片日邊來"]},{"title":"獨坐敬亭山","author":"李白","type":"","lines":["衆鳥高飛盡","孤雲獨去閑","相看兩不厭","只有敬亭山"],"featured":true},{"title":"把酒問月","author":"李白","type":"","lines":["青天有月來幾時","我今停杯一問之","人攀明月不可得","月行却與人相隨","皎如飛鏡臨丹闕","綠烟滅盡清輝發","但見宵從海上來","寧知曉向雲間沒","白兔擣藥秋復春","嫦娥孤棲與誰鄰","今人不見古時月","今月曾經照古人","古人今人若流水","共看明月皆如此","唯願當歌對酒時","月光長照金樽裏"],"featured":true},{"title":"望廬山瀑布","author":"李白","type":"","lines":["日照香爐生紫煙","遙看瀑布挂前川","飛流直下三千尺","疑是銀河落九天"],"featured":true},{"title":"秋浦歌","author":"李白","type":"","lines":["白髮三千丈","緣愁似個長","不知明鏡裡","何處得秋霜"]},{"title":"登金陵鳳凰臺","author":"李白","type":"","lines":["鳳凰臺上鳳凰遊","鳳去臺空江自流","吳宮花草埋幽徑","晉代衣冠成古丘","三山半落青天外","二水中分白鷺洲","總爲浮雲能蔽日","長安不見使人愁"]},{"title":"早發白帝城","author":"李白","type":"","lines":["朝辭白帝彩雲間","千里江陵一日還","兩岸猨聲啼不盡","輕舟已過萬重山"],"featured":true},{"title":"山行","author":"杜牧","type":"","lines":["遠上寒山石徑斜","白雲生處有人家","停車坐愛楓林晚","霜葉紅於二月花"],"featured":true},{"title":"江南春","author":"杜牧","type":"","lines":["千里鶯啼綠映江","水村山郭酒旗風","南朝四百八十寺","多少樓臺煙雨中"],"featured":true},{"title":"春夜喜雨","author":"杜甫","type":"","lines":["好雨知時節","當春乃發生","隨風潛入夜","潤物細無聲","野徑雲俱黑","江船火獨明","曉看紅濕處","花重錦官城"],"featured":true},{"title":"江畔獨步尋花","author":"杜甫","type":"","lines":["黃四娘家花滿蹊","千朵萬朵壓枝低","留連戲蝶時時舞","自在嬌鶯恰恰啼"],"featured":true},{"title":"登幽州臺歌","author":"陳子昂","type":"","lines":["前不見古人","後不見來者","念天地之悠悠","獨愴然而涕下"],"featured":true},{"title":"回鄉偶書","author":"賀知章","type":"","lines":["少小離家老大回","鄉音難改鬢毛衰","兒童相見不相識","笑問客從何處來"],"featured":true},{"title":"詠柳","author":"賀知章","type":"","lines":["碧玉妝成一樹高","萬條垂下綠絲縧","不知細葉誰裁出","二月春風似剪刀"],"featured":true},{"title":"憫農","author":"李紳","type":"","lines":["鋤禾日當午","汗滴禾下土","誰知盤中餐","粒粒皆辛苦"],"featured":true},{"title":"憫農","author":"李紳","type":"","lines":["春種一粒粟","秋成萬顆子","四海無閑田","農夫猶餓死"],"featured":true},{"title":"送元二使安西","author":"王維","type":"","lines":["客舍青青楊柳春","勸君更盡一杯酒","西出陽關無故人"],"featured":true},{"title":"竹枝詞","author":"劉禹錫","type":"","lines":["楊柳青青江水平","聞郎江上唱歌聲","東邊日出西邊雨","道是無晴却有晴"],"featured":true},{"title":"浪淘沙","author":"劉禹錫","type":"","lines":["九曲黃河萬里沙","浪淘風簸自天涯","如今直上銀河去","同到牽牛織女家"],"featured":true},{"title":"望洞庭","author":"劉禹錫","type":"","lines":["湖光秋月兩相和","潭面無風鏡未磨","遙望洞庭山水翠","白銀盤裏一青螺"],"featured":true},{"title":"憶江南","author":"白居易","type":"","lines":["江南好","風景舊曾諳"]},{"title":"江雪","author":"柳宗元","type":"","lines":["千山鳥飛絕","萬逕人蹤滅","孤舟蓑笠翁","獨釣寒江雪"],"featured":true},{"title":"出塞","author":"王昌齡","type":"","lines":["秦時明月漢時關","萬里長征人未還","但使龍城飛將在","不教胡馬度陰山"],"featured":true},{"title":"涼州詞","author":"王翰","type":"","lines":["葡萄美酒夜光杯","欲飲琵琶馬上催","醉臥沙場君莫笑","古來征戰幾人回"],"featured":true},{"title":"春曉","author":"孟浩然","type":"","lines":["春眠不覺曉","處處聞啼鳥","夜來風雨聲","花落知多少"],"featured":true},{"title":"登鸛雀樓","author":"王之渙","type":"","lines":["白日依山盡","黃河入海流","欲窮千里目","更上一層樓"],"featured":true},{"title":"在獄詠蟬","author":"駱賓王","type":"","lines":["西陸蟬聲唱","南冠客思侵","那堪玄鬢影","來對白頭吟","露重飛難進","風多響易沈","無人信高潔","誰爲表予心"]},{"title":"題西林壁","author":"蘇軾","type":"","lines":["橫看成嶺側成峰","遠近高低總不同","不識廬山真面目","只緣身在此山中"],"featured":true},{"title":"惠崇春江晚景","author":"蘇軾","type":"","lines":["竹外桃花三兩枝","春江水暖鴨先知","蔞蒿滿地蘆芽短","正是河豚欲上時"],"featured":true},{"title":"曉出淨慈寺送林子方","author":"楊萬里","type":"","lines":["畢竟西湖六月中","風光不與四時同","接天蓮葉無窮碧","映日荷花別樣紅"],"featured":true},{"title":"小池","author":"楊萬里","type":"","lines":["泉眼無聲惜細流","樹陰照水愛晴柔","小荷纔露尖尖角","早有蜻蜓立上頭"],"featured":true},{"title":"示兒","author":"陸游","type":"","lines":["死去元知萬事空","但悲不見九州同","王師北定中原日","家祭無忘告乃翁"],"featured":true},{"title":"遊山西村","author":"陸游","type":"","lines":["莫笑農家臘酒渾","豐年留客足雞豚","山重水複疑無路","柳暗花明又一村","簫鼓追隨春社近","衣冠簡朴古風存","從今若許閑乘月","拄杖無時夜叩門"],"featured":true},{"title":"泊船瓜洲","author":"王安石","type":"","lines":["京口瓜洲一水間","鍾山祇隔數重山","春風自綠江南岸","明月何時照我還"],"featured":true},{"title":"元日","author":"王安石","type":"","lines":["爆竹聲中一歲除","東風送暖入屠蘇","千門萬戶曈曈日","爭插新桃換舊符"],"featured":true},{"title":"梅花","author":"王安石","type":"","lines":["牆角數枝梅","凌寒獨自開","遥知不是雪","爲有暗香來"],"featured":true},{"title":"春日","author":"朱熹","type":"","lines":["勝日尋芳泗水濱","無邊光景一時新","等閑識得東風面","萬紫千紅總是春"],"featured":true},{"title":"觀書有感","author":"朱熹","type":"","lines":["半畝方塘一鑑開","天光雲影共徘徊","問渠那得清如許","爲有源頭活水來"],"featured":true},{"title":"題臨安邸","author":"林升","type":"","lines":["山外青山樓外樓","西湖歌舞幾時休","暖風薰得遊人醉","直把杭州作汴州"],"featured":true},{"title":"四時田園雜興","author":"范成大","type":"","lines":["晝出耘田夜績麻","村莊兒女各當家","童孫未解供耕織","也傍桑陰學種瓜"],"featured":true},{"title":"春日偶成","author":"程顥","type":"","lines":["雲淡風輕近午天","望花隨柳過前川","旁人不識予心樂","將謂偷閑學少年"]}]}