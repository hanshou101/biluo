{"id":"extras","name":"名篇补遗","script":"zh-Hans","source":"chinese-poetry@b8594f8 全唐诗/全宋诗（见 scripts/extras.json）","license":"MIT","poems":[{"title":"春江花月夜","author":"张若虚","type":"","lines":["春江潮水连海平","海上明月共潮生","滟滟随波千万里","何处春江无月明","江流宛转绕芳甸","月照花林皆似霰","空里流霜不觉飞","汀上白沙看不见","江天一色无纤尘","皎皎空中孤月轮","江畔何人初见月","江月何年初照人","人生代代无穷已","江月年年望相似","不知江月待何人","但见长江送流水","白云一片去悠悠","青枫浦上不胜愁","谁家今夜扁舟子","何处相思明月楼","可怜楼上月裴回","应照离人妆镜台","玉户帘中卷不去","捣衣砧上拂还来","此时相望不相闻","愿逐月华流照君","鸿雁长飞光不度","鱼龙潜跃水成文","昨夜闲潭梦落花","可怜春半不还家","江水流春去欲尽","江潭落月复西斜","斜月沈沈藏海雾","碣石潇湘无限路","不知乘月几人归","落月摇情满江树"],"featured":true},{"title":"咏鹅","author":"骆宾王","type":"","lines":["曲项向天歌","白毛浮绿水","红掌拨清波"],"featured":true},{"title":"赠汪伦","author":"李白","type":"","lines":["李白乘舟将欲行","忽闻岸上踏歌声","桃花潭水深千尺","不及汪伦送我情"],"featured":true},{"title":"望天门山","author":"李白","type":"","lines":["天门中断楚江开","碧水东流至北回","两岸青山相对出","孤帆一片日边来"]},{"title":"独坐敬亭山","author":"李白","type":"","lines":["众鸟高飞尽","孤云独去闲","相看两不厌","只有敬亭山"],"featured":true},{"title":"把酒问月","author":"李白","type":"","lines":["青天有月来几时","我今停杯一问之","人攀明月不可得","月行却与人相随","皎如飞镜临丹阙","绿烟灭尽清辉发","但见宵从海上来","宁知晓向云间没","白兔捣药秋复春","嫦娥孤栖与谁邻","今人不见古时月","今月曾经照古人","古人今人若流水","共看明月皆如此","唯愿当歌对酒时","月光长照金樽里"],"featured":true},{"title":"望庐山瀑布","author":"李白","type":"","lines":["日照香炉生紫烟","遥看瀑布挂前川","飞流直下三千尺","疑是银河落九天"],"featured":true},{"title":"秋浦歌","author":"李白","type":"","lines":["白发三千丈","缘愁似个长","不知明镜里","何处得秋霜"]},{"title":"登金陵凤凰台","author":"李白","type":"","lines":["凤凰台上凤凰游","凤去台空江自流","吴宫花草埋幽径","晋代衣冠成古丘","三山半落青天外","二水中分白鹭洲","总为浮云能蔽日","长安不见使人愁"]},{"title":"早发白帝城","author":"李白","type":"","lines":["朝辞白帝彩云间","千里江陵一日还","两岸猨声啼不尽","轻舟已过万重山"],"featured":true},{"title":"山行","author":"杜牧","type":"","lines":["远上寒山石径斜","白云生处有人家","停车坐爱枫林晚","霜叶红于二月花"],"featured":true},{"title":"江南春","author":"杜牧","type":"","lines":["千里莺啼绿映江","水村山郭酒旗风","南朝四百八十寺","多少楼台烟雨中"],"featured":true},{"title":"春夜喜雨","author":"杜甫","type":"","lines":["好雨知时节","当春乃发生","随风潜入夜","润物细无声","野径云俱黑","江船火独明","晓看红湿处","花重锦官城"],"featured":true},{"title":"江畔独步寻花","author":"杜甫","type":"","lines":["黄四娘家花满蹊","千朵万朵压枝低","留连戏蝶时时舞","自在娇莺恰恰啼"],"featured":true},{"title":"登幽州台歌","author":"陈子昂","type":"","lines":["前不见古人","后不见来者","念天地之悠悠","独怆然而涕下"],"featured":true},{"title":"回乡偶书","author":"贺知章","type":"","lines":["少小离家老大回","乡音难改鬓毛衰","儿童相见不相识","笑问客从何处来"],"featured":true},{"title":"咏柳","author":"贺知章","type":"","lines":["碧玉妆成一树高","万条垂下绿丝绦","不知细叶谁裁出","二月春风似剪刀"],"featured":true},{"title":"悯农","author":"李绅","type":"","lines":["锄禾日当午","汗滴禾下土","谁知盘中餐","粒粒皆辛苦"],"featured":true},{"title":"悯农","author":"李绅","type":"","lines":["春种一粒粟","秋成万颗子","四海无闲田","农夫犹饿死"],"featured":true},{"title":"送元二使安西","author":"王维","type":"","lines":["客舍青青杨柳春","劝君更尽一杯酒","西出阳关无故人"],"featured":true},{"title":"竹枝词","author":"刘禹锡","type":"","lines":["杨柳青青江水平","闻郎江上唱歌声","东边日出西边雨","道是无晴却有晴"],"featured":true},{"title":"浪淘沙","author":"刘禹锡","type":"","lines":["九曲黄河万里沙","浪淘风簸自天涯","如今直上银河去","同到牵牛织女家"],"featured":true},{"title":"望洞庭","author":"刘禹锡","type":"","lines":["湖光秋月两相和","潭面无风镜未磨","遥望洞庭山水翠","白银盘里一青螺"],"featured":true},{"title":"忆江南","author":"白居易","type":"","lines":["江南好","风景旧曾谙"]},{"title":"江雪","author":"柳宗元","type":"","lines":["千山鸟飞绝","万径人踪灭","孤舟蓑笠翁","独钓寒江雪"],"featured":true},{"title":"出塞","author":"王昌龄","type":"","lines":["秦时明月汉时关","万里长征人未还","但使龙城飞将在","不教胡马度阴山"],"featured":true},{"title":"凉州词","author":"王翰","type":"","lines":["葡萄美酒夜光杯","欲饮琵琶马上催","醉卧沙场君莫笑","古来征战几人回"],"featured":true},{"title":"春晓","author":"孟浩然","type":"","lines":["春眠不觉晓","处处闻啼鸟","夜来风雨声","花落知多少"],"featured":true},{"title":"登鹳雀楼","author":"王之涣","type":"","lines":["白日依山尽","黄河入海流","欲穷千里目","更上一层楼"],"featured":true},{"title":"在狱咏蝉","author":"骆宾王","type":"","lines":["西陆蝉声唱","南冠客思侵","那堪玄鬓影","来对白头吟","露重飞难进","风多响易沈","无人信高洁","谁为表予心"]},{"title":"题西林壁","author":"苏轼","type":"","lines":["横看成岭侧成峰","远近高低总不同","不识庐山真面目","只缘身在此山中"],"featured":true},{"title":"惠崇春江晚景","author":"苏轼","type":"","lines":["竹外桃花三两枝","春江水暖鸭先知","蒌蒿满地芦芽短","正是河豚欲上时"],"featured":true},{"title":"晓出净慈寺送林子方","author":"杨万里","type":"","lines":["毕竟西湖六月中","风光不与四时同","接天莲叶无穷碧","映日荷花别样红"],"featured":true},{"title":"小池","author":"杨万里","type":"","lines":["泉眼无声惜细流","树阴照水爱晴柔","小荷才露尖尖角","早有蜻蜓立上头"],"featured":true},{"title":"示儿","author":"陆游","type":"","lines":["死去元知万事空","但悲不见九州同","王师北定中原日","家祭无忘告乃翁"],"featured":true},{"title":"游山西村","author":"陆游","type":"","lines":["莫笑农家腊酒浑","丰年留客足鸡豚","山重水复疑无路","柳暗花明又一村","箫鼓追随春社近","衣冠简朴古风存","从今若许闲乘月","拄杖无时夜叩门"],"featured":true},{"title":"泊船瓜洲","author":"王安石","type":"","lines":["京口瓜洲一水间","钟山祇隔数重山","春风自绿江南岸","明月何时照我还"],"featured":true},{"title":"元日","author":"王安石","type":"","lines":["爆竹声中一岁除","东风送暖入屠苏","千门万户曈曈日","争插新桃换旧符"],"featured":true},{"title":"梅花","author":"王安石","type":"","lines":["墙角数枝梅","凌寒独自开","遥知不是雪","为有暗香来"],"featured":true},{"title":"春日","author":"朱熹","type":"","lines":["胜日寻芳泗水滨","无边光景一时新","等闲识得东风面","万紫千红总是春"],"featured":true},{"title":"观书有感","author":"朱熹","type":"","lines":["半亩方塘一鉴开","天光云影共徘徊","问渠那得清如许","为有源头活水来"],"featured":true},{"title":"题临安邸","author":"林升","type":"","lines":["山外青山楼外楼","西湖歌舞几时休","暖风薰得游人醉","直把杭州作汴州"],"featured":true},{"title":"四时田园杂兴","author":"范成大","type":"","lines":["昼出耘田夜绩麻","村庄儿女各当家","童孙未解供耕织","也傍桑阴学种瓜"],"featured":true},{"title":"春日偶成","author":"程颢","type":"","lines":["云淡风轻近午天","望花随柳过前川","旁人不识予心乐","将谓偷闲学少年"]}]}